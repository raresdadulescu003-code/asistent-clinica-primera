# Copiază fișierul ăsta în `.env` și completează valorile.
# `.env` e în .gitignore și nu se urcă niciodată nicăieri.
# În producție, variabilele se pun în panoul host-ului, NU într-un fișier
# `.env` urcat pe server.

# --- Anthropic (obligatoriu) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# "5m" ar expira între vizitatori; "1h" costă dublu la scriere, dar
# keep-alive-ul la 50 de minute face ca rescrierea să nu se mai întâmple.
ANTHROPIC_CACHE_TTL=1h
ANTHROPIC_KEEPALIVE_MINUTES=50

# --- Server ---
ENVIRONMENT=development
# Originile care au voie să apeleze API-ul, separate prin virgulă.
# NU pune "*" în producție. Atenție: cu și fără "www" sunt origini DIFERITE.
SERVER_ALLOWED_ORIGINS=https://www.clinicaprimera.ro,https://clinicaprimera.ro
SERVER_PORT=8000
# Token pentru POST /api/refresh. Generează-l cu:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVER_REFRESH_TOKEN=

# --- Datele clinicii (intră în promptul agentului) ---
CLINIC_NAME=Clinica Primera
CLINIC_PHONE=0349 999
CLINIC_PHONE_ALT=0775 326 574
CLINIC_EMAIL=office@clinicaprimera.ro

# --- Scraper ---
SCRAPER_INTERVAL_HOURS=24

# --- Limite de trafic (pe IP) ---
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_PER_DAY=150
